set positional-arguments

default:
    @just --list

build:
    cargo build --locked

fmt:
    cargo fmt --all

check:
    cargo check --locked --all-targets

smoke:
    cargo run --locked --example smoke

verify:
    cargo fmt --all --check
    cargo clippy --locked --all-targets -- -D warnings
    cargo test --locked --all-targets
    cargo test --locked --doc
